import React, { useContext, useState, useEffect } from 'react';
import { Card, Row, Col, Layout, Badge, Statistic, Typography, Divider, Alert } from 'antd';
import { Link } from 'react-router-dom';
import {
  UserAddOutlined,
  MedicineBoxOutlined,
  FileTextOutlined,
  LockOutlined,
  UserOutlined,
  FileDoneOutlined,
  ContainerOutlined,
  ExperimentOutlined,
} from '@ant-design/icons';
import { Pie, Column } from '@ant-design/plots';
import NavbarTemplate from './NavbarTemplate';
import { ClinicContext } from '../../context/ClinicContext';

const { Content } = Layout;
const { Title } = Typography;

// Define a CSS style for fade-in and fade-out animations
const fadeInOutStyle = `
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes fadeOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-10px); }
  }
  
  .fade-in {
    animation: fadeIn 0.5s ease forwards;
  }
  
  .fade-out {
    animation: fadeOut 0.5s ease forwards;
  }
`;

const TemplateCards = () => {  
  const { isAuthenticated, user, logout, pacientes = [], triagensRealizadas = [], consultasRealizadas = [], triagensPendentes = [], consultasPendentes = [], examesPendentes = [], examesConcluidos = [] } = useContext(ClinicContext);
  // State para controlar a visibilidade da mensagem de boas-vindas
  const [showWelcomeMessage, setShowWelcomeMessage] = useState(true);
  const [fadeOutClass, setFadeOutClass] = useState('');
  
  // useEffect para esconder a mensagem após 3 segundos
  useEffect(() => {
    if (showWelcomeMessage) {
      // Primeiro adicionar a classe de fade-out após 2.5 segundos
      const fadeTimer = setTimeout(() => {
        setFadeOutClass('fade-out');
      }, 2500); // 2.5 segundos
      
      // Depois esconder a mensagem completamente após 3 segundos
      const hideTimer = setTimeout(() => {
        setShowWelcomeMessage(false);
      }, 3000); // 3 segundos
      
      // Limpar os timers quando o componente for desmontado
      return () => {
        clearTimeout(fadeTimer);
        clearTimeout(hideTimer);
      };
    }
  }, [showWelcomeMessage]); // Depende de showWelcomeMessage
  
  // Adicionar verificações de segurança ao acessar propriedades
  const totalPacientes = pacientes?.length || 0;
  const totalTriagens = triagensRealizadas?.length || 0;
  const totalConsultas = consultasRealizadas?.length || 0;
  const totalTriagensPendentes = triagensPendentes?.length || 0;
  const totalConsultasPendentes = consultasPendentes?.length || 0;
  const totalExamesPendentes = examesPendentes?.length || 0;
  const totalExamesConcluidos = examesConcluidos?.length || 0;
  // Contagem de consultas por status
  const consultasFinalizadas = consultasRealizadas?.filter(c => c.status === 'alta')?.length || 0;
  // Adicionar contagem de óbitos
  const consultasObitos = consultasRealizadas?.filter(c => c.status === 'obito')?.length || 0;
  // Adicionar contagem de transferências
  const consultasTransferidas = consultasRealizadas?.filter(c => c.status === 'transferido')?.length || 0;
  // Calcular datas para hoje e ontem
  const hoje = new Date();
  const ontem = new Date(hoje);
  ontem.setDate(hoje.getDate() - 1);
  // Formatar as datas para comparação (formato ISO sem horas)
  const formatarData = (data) => {
    if (!data) return null;
    return `${data.getFullYear()}-${String(data.getMonth() + 1).padStart(2, '0')}-${String(data.getDate()).padStart(2, '0')}`;
  };
  
  const dataHoje = formatarData(hoje);
  const dataOntem = formatarData(ontem);
  
  // Filtrar pacientes cadastrados hoje
  const pacientesHoje = pacientes?.filter(p => {
    if (!p.dataCadastro) return false;
    const dataCadastro = formatarData(new Date(p.dataCadastro));
    return dataCadastro === dataHoje;
  })?.length || 0;
  
  // Filtrar pacientes cadastrados ontem
  const pacientesOntem = pacientes?.filter(p => {
    if (!p.dataCadastro) return false;
    const dataCadastro = formatarData(new Date(p.dataCadastro));
    return dataCadastro === dataOntem;
  })?.length || 0;
  
  // Pacientes em processo (registrados mas sem consulta finalizada)
  const pacientesEmProcesso = pacientes?.filter(p => {
    // Verificar se o paciente tem triagem realizada
    const temTriagem = triagensRealizadas?.some(t => t.pacienteId === p.id);
    // Verificar se o paciente NÃO tem consulta com status 'alta'
    const naoTemAlta = !consultasRealizadas?.some(c => c.pacienteId === p.id && c.status === 'alta');
    // Retornar verdadeiro se tem triagem e não tem alta
    return temTriagem && naoTemAlta;
  })?.length || 0;
  
  // Dados para o gráfico de Pizza com verificações de segurança
  const pieData = [
    {
      type: 'Triagens',
      value: totalTriagens,
    },
    {
      type: 'Consultas',
      value: totalConsultas,
    },
    {
      type: 'Altas Médicas',
      value: consultasRealizadas.filter(c => c.status === 'alta')?.length || 0,
    },
  ];  
  // Verifica se há valores para exibir e mostra apenas se tiver
  const hasPieData = pieData.some(item => item.value > 0);
  
  const pieConfig = {
    appendPadding: 10,
    data: pieData,
    angleField: 'value',
    colorField: 'type',
    radius: 0.8,
    legend: {
      position: 'bottom',
    },
    interactions: [{ type: 'element-active' }],
  };

  // Dados para o gráfico de Coluna (barras) - Simulando crescimento
  const columnData = [
    { month: 'Janeiro', pacientes: 10 },
    { month: 'Fevereiro', pacientes: 20 },
    { month: 'Março', pacientes: 30 },
    { month: 'Abril', pacientes: 40 },
    { month: 'Maio', pacientes: totalPacientes }, // Usando a variável segura
  ];

  const columnConfig = {
    data: columnData,
    xField: 'month',
    yField: 'pacientes',
    color: '#5B8FF9',
    meta: {
      pacientes: { alias: 'Pacientes' },
    }
  };  
  
  // Remover o Dashboard e manter apenas os outros 3 cards
  const allCards = [
    {
      key: 'atendimento',
      title: 'Aceitação',
      icon: <UserAddOutlined style={{ fontSize: '20px', color: '#28a745' }} />,
      route: '/atendimento',
      role: 'aceitacao',
      counts: [
        { title: 'Hoje', value: pacientesHoje, color: '#52c41a' },
        { title: 'Ontem', value: pacientesOntem, color: '#1890ff' },
        { title: 'Em Processo', value: pacientesEmProcesso, color: '#fa8c16' },
        { title: 'Transferências', value: consultasTransferidas, color: '#722ed1' }
      ]
    },
    {
      key: 'enfermaria',
      title: 'Triagem',
      icon: <MedicineBoxOutlined style={{ fontSize: '20px', color: '#28a745' }} />,
      route: '/enfermaria',
      role: 'enfermeiro',
      counts: [
        { title: 'Em Espera', value: totalTriagensPendentes, color: '#fa8c16' },
        { title: 'Realizadas', value: totalTriagens, color: '#52c41a' }
      ]
    },
    {
      key: 'consultorio',
      title: 'Consultório',
      icon: <MedicineBoxOutlined style={{ fontSize: '20px', color: '#28a745' }} />,
      route: '/consultorio',
      role: 'medico',
      counts: [
        { title: 'Em Espera', value: totalConsultasPendentes, color: '#fa8c16' },
        { title: 'Finalizadas', value: consultasFinalizadas, color: '#52c41a' },
        { title: 'Óbitos', value: consultasObitos, color: '#f5222d' }
      ]
    },
    {
      key: 'laboratorio',
      title: 'Laboratório',
      icon: <ExperimentOutlined style={{ fontSize: '20px', color: '#28a745' }} />,
      route: '/laboratorio',
      role: 'analista',
      counts: [
        { title: 'Pendentes', value: totalExamesPendentes, color: '#fa8c16' },
        { title: 'Concluídos', value: totalExamesConcluidos, color: '#52c41a' }
      ]
    }
  ];
  
  // Filter cards based on user role - admin gets all cards, others get only their specific card
  const cardData = user.role === 'admin' 
    ? allCards 
    : allCards.filter(card => card.role === user.role);
  
  // Não precisamos mais de distribuição em colunas
  return (
    <Layout>
      {/* Add style tag for animations */}
      <style>{fadeInOutStyle}</style>
      
      <NavbarTemplate />
      <Content style={{ background: '#f5f5f5', padding: '30px 0' }}>
        <div className="container" style={{ 
          maxWidth: '1100px', 
          margin: '0 auto', 
          padding: '0 20px',
          background: '#fff',
          borderRadius: '8px',
          boxShadow: '0 2px 8px rgba(0,0,0,0.06)'
        }}>
          <div style={{ padding: '20px' }}>
            {/* Welcome message with user role - shown for 3 seconds */}
            {showWelcomeMessage && (
              <Alert
                message={
                  <h2 style={{ 
                    margin: 0, 
                    color: '#28a745', 
                    fontSize: '18px' 
                  }}>
                    <UserOutlined style={{ marginRight: '8px' }} />
                    Bem-vindo, {user.name}
                  </h2>
                }
                description={
                  <p style={{ margin: 0, color: '#666' }}>
                    Você está conectado como <strong>{user.department}</strong> com a função de <strong>{user.role === 'admin' ? 'Administrador' : user.role}</strong>
                  </p>
                }
                type="success"
                showIcon={false}
                className={`fade-in ${fadeOutClass}`}
                style={{
                  marginBottom: '20px',
                  borderRadius: '8px',
                  border: '1px solid #d6e4ff'
                }}
                banner
              />
            )}
            
            {/* Cards alinhados - ajustando layout baseado no número de cards */}
            <Row gutter={[16, 16]} justify="center">
              {cardData.map((card) => (
                <Col key={card.key} 
                  xs={24} 
                  sm={cardData.length === 1 ? 24 : 12} 
                  md={cardData.length === 1 ? 12 : (cardData.length <= 2 ? 12 : 6)}
                  style={{ display: 'flex', justifyContent: cardData.length === 1 ? 'center' : 'flex-start' }}
                >
                  <Link to={card.route}>             
                    <Card
                      hoverable
                      size="small"
                      style={{
                        textAlign: 'center',
                        border: '1px solid #e0e0e0',
                        borderRadius: '8px',
                        overflow: 'hidden',
                        boxShadow: '0 2px 6px rgba(0, 0, 0, 0.03)',
                        transition: 'all 0.3s ease'
                      }}
                      bodyStyle={{ padding: '16px 12px' }}
                    >
                      <div style={{ marginBottom: 8, position: 'relative' }}>
                        {card.icon}
                        {card.requiresAuth && (
                          <LockOutlined 
                            style={{ 
                              position: 'absolute', 
                              top: -6, 
                              right: -6, 
                              color: '#f5222d', 
                              fontSize: '12px',
                              background: '#fff',
                              borderRadius: '50%',
                              padding: '2px'
                            }} 
                          />
                        )}
                      </div>
                      <h3 style={{ 
                        margin: 0, 
                        color: '#28a745', 
                        fontSize: '16px',
                        fontWeight: 'bold'
                      }}>
                        {card.title}
                      </h3>
                      {/* Exibir contagens se disponíveis */}
                      {card.counts && (
                        <div style={{ marginTop: 10 }}>
                          <Row gutter={[8, 8]}>
                            {card.counts.map((count, index) => (
                              <Col key={index} span={8}>
                                <div style={{ 
                                  display: 'flex', 
                                  flexDirection: 'column',
                                  alignItems: 'center',
                                  padding: '2px 0'
                                }}>
                                  <Badge 
                                    count={count.value} 
                                    style={{ 
                                      backgroundColor: count.color,
                                      fontSize: '12px',
                                      fontWeight: 'bold',
                                      minWidth: '28px',
                                      height: '22px',
                                      padding: '0 8px',
                                      lineHeight: '22px'
                                    }} 
                                    showZero
                                  />
                                  <span style={{ 
                                    fontSize: '11px', 
                                    fontWeight: 'bold',
                                    color: '#666',
                                    marginTop: '4px'
                                  }}>
                                    {count.title}
                                  </span>
                                </div>
                              </Col>
                            ))}
                          </Row>
                        </div>
                      )}
                    </Card>
                  </Link>
                </Col>
              ))}
            </Row>

            {/* Gráficos de Desempenho */}
            <Divider style={{ margin: '30px 0 20px' }}>
              <Title level={4} style={{ 
                color: '#28a745', 
                margin: 0,
                display: 'flex',
                alignItems: 'center',
                gap: '8px'
              }}>
                <FileTextOutlined /> Gráficos de Desempenho
              </Title>
            </Divider>

            <Row gutter={[16, 16]}>
              <Col xs={24} md={12}>
                <Card
                  hoverable
                  size="small"
                  style={{
                    borderRadius: '8px',
                    overflow: 'hidden',
                    background: 'white',
                    border: '1px solid #e2e8f0',
                    boxShadow: '0 2px 6px rgba(0,0,0,0.03)'
                  }}
                  bodyStyle={{ padding: '12px' }}
                >
                  <Title level={5} style={{ margin: '0 0 8px 0', color: '#28a745', fontSize: '16px' }}>Distribuição de Triagens e Consultas</Title>
                  <div style={{ height: '200px' }}>
                    <Pie {...pieConfig} />
                  </div>
                </Card>
              </Col>

              <Col xs={24} md={12}>
                <Card
                  hoverable
                  size="small"
                  style={{
                    borderRadius: '8px',
                    overflow: 'hidden',
                    background: 'white',
                    border: '1px solid #e2e8f0',
                    boxShadow: '0 2px 6px rgba(82, 46, 46, 0.03)'
                  }}
                  bodyStyle={{ padding: '12px' }}
                >
                  <Title level={5} style={{ margin: '0 0 8px 0', color: '#28a745', fontSize: '16px' }}>Crescimento de Pacientes</Title>
                  <div style={{ height: '200px' }}>
                    <Column {...columnConfig} />
                  </div>
                </Card>
              </Col>
            </Row>
          </div>
        </div>
      </Content>
    </Layout>
  );
};

export default TemplateCards;
