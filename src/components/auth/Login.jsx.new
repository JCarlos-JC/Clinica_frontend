import React, { useState, useContext } from 'react';
import { ClinicContext } from '../../context/ClinicContext';
import { Card, Input, Button, message, Layout } from 'antd';
import { useNavigate } from 'react-router-dom';

const { Header, Footer: AntFooter, Content } = Layout;

const Login = () => {
    const { login } = useContext(ClinicContext) || {};
    const [username, setUsername] = useState('');
    const [password, setPassword] = useState('');
    const navigate = useNavigate();
    
    const handleLogin = () => {
        if (!login) return message.error("Erro interno: contexto não disponível.");
        const success = login(username, password);
        if (success) {
            message.success('Login realizado com sucesso!');
            navigate('/home'); // Redireciona para a página de cards após o login
        } else {
            message.error('Usuário ou senha inválidos!');
        }
    };
    
    return (
        <Layout style={{ minHeight: '100vh' }}>
            <style>{`
                body {
                  margin: 0;
                  padding: 0;
                  background-color: #f3f4f6;
                }
                
                .login-header {
                  background-color: #fff;
                  padding: 15px 40px;
                  border-bottom: 3px solid #28a745;
                  display: flex;
                  align-items: center;
                  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                }
                
                .login-container {
                  flex: 1;
                  display: flex;
                  justify-content: center;
                  align-items: center;
                  padding: 20px;
                }
                
                .login-card {
                  width: 100%;
                  max-width: 400px;
                  border-radius: 8px;
                  box-shadow: 0 0 15px rgba(0, 0, 0, 0.15);
                }
                
                .login-footer {
                  text-align: center;
                  padding: 16px 0;
                  font-size: 12px;
                  color: #888;
                  background-color: #fff;
                  border-top: 1px solid #eee;
                }
            `}</style>
            
            {/* Header com logo */}
            <Header className="login-header">
                <div style={{ display: 'flex', alignItems: 'center', gap: 16 }}>
                    <img
                        src="/assets/images/UEM.png"
                        alt="Logo"
                        style={{ height: 60 }}
                    />
                    <div
                        style={{
                            borderLeft: '2px solid #28a745',
                            height: '40px',
                            margin: '0 16px'
                        }}
                    />
                    <div style={{ display: 'flex', flexDirection: 'column', lineHeight: 1.2 }}>
                        <h3 style={{ margin: 0, color: '#28a745', fontSize: '18px' }}>
                            Sistema da Clínica Universitária
                        </h3>
                        <span style={{ fontSize: 14, color: '#666' }}>
                            SCLIUEM
                        </span>
                    </div>
                </div>
            </Header>
            
            {/* Conteúdo principal */}
            <Content style={{ 
                display: 'flex',
                justifyContent: 'center',
                alignItems: 'center',
                padding: '40px 20px',
                backgroundColor: '#f3f4f6'
            }}>
                <Card className="login-card" bordered={false}>
                    <div style={{ textAlign: 'center', marginBottom: '30px' }}>
                        <img
                            src="/assets/images/UEM.png"
                            alt="Logo"
                            style={{ height: 80, marginBottom: '10px' }}
                        />
                        <h3 style={{ color: '#28a745', marginBottom: '5px' }}>
                            Sistema da Clínica Universitária
                        </h3>
                        <h4 style={{ color: '#666', fontWeight: 'normal' }}>
                            Bem-vindo
                        </h4>
                    </div>
                    
                    <Input
                        placeholder="Digite o seu e-mail"
                        value={username}
                        onChange={e => setUsername(e.target.value)}
                        style={{ marginBottom: 16 }}
                        size="large"
                    />
                    <Input.Password
                        placeholder="Digite a sua senha"
                        value={password}
                        onChange={e => setPassword(e.target.value)}
                        style={{ marginBottom: 24 }}
                        size="large"
                    />
                    <Button 
                        type="primary" 
                        block 
                        onClick={handleLogin} 
                        style={{ 
                            background: '#28a745', 
                            borderColor: '#28a745',
                            height: '40px',
                            fontSize: '16px'
                        }}
                        size="large"
                    >
                        Aceder à sua conta
                    </Button>
                </Card>
            </Content>
            
            {/* Footer */}
            <AntFooter className="login-footer">
                © {new Date().getFullYear()} CIUEM - Todos os direitos reservados
            </AntFooter>
        </Layout>
    );
};

export default Login;
